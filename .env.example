# Copy this file to .env and fill it in. Never commit .env.
# Leave META_APP_ID empty to run in demo mode with a simulated ad account (this computer only).

META_APP_ID=
META_APP_SECRET=
# How people connect: token (paste a token from Marketing API → Tools), oauth (Facebook Login), or token,oauth.
# Facebook Login for Business needs Advanced Access and Business Verification, so token is the default.
META_LOGIN_MODE=token
# Only for oauth: a Facebook Login for Business configuration ID (if your app uses one)
META_LOGIN_CONFIG_ID=
META_API_VERSION=v25.0

PORT=8787
BASE_URL=http://localhost:8787

# --- Hosted (Vercel) only; see DEPLOY-VERCEL.md ---
# Turso database (added automatically when you connect Turso in Vercel)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# 32 random bytes, base64. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_SECRET_KEY=
# Any long random string; Vercel sends it with the daily cron request
CRON_SECRET=

# How often accounts with auto-sync on are synced (hours), and how far back the first sync goes (days)
SYNC_EVERY_HOURS=24
SYNC_BACKFILL_DAYS=90
# Longest single sync step (seconds). Keep under Vercel's 300 s limit.
SYNC_STEP_SECONDS=240
# How long share links last by default (days)
SHARE_DAYS=30
